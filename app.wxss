page {
  background: #0b1220;
  color: #e5e7eb;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.container {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.card {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
}

.subtitle {
  font-size: 26rpx;
  color: #9ca3af;
}

.button-primary {
  background: linear-gradient(90deg, #7c3aed, #06b6d4);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 30rpx;
}

.tag {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(124, 58, 237, 0.12);
  color: #c084fc;
  font-size: 24rpx;
}

.field-label {
  color: #9ca3af;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.input {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  padding: 18rpx;
  color: #e5e7eb;
}

.model-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.model-option {
  padding: 12rpx 24rpx;
  border-radius: 14rpx;
  border: 1px solid rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.04);
  color: #e5e7eb;
  font-size: 26rpx;
}

.model-option.active {
  border-color: #7c3aed;
  background: rgba(124, 58, 237, 0.12);
  color: #d8b4fe;
}

.result {
  white-space: pre-wrap;
  line-height: 1.7;
  color: #d1d5db;
}

.small-text {
  font-size: 24rpx;
  color: #9ca3af;
}
